{
  "name": "issue-jump",
  "version": "1.2.0",
  "private": true,
  "description": "Chrome extension that opens any issue in one keystroke, across Jira, GitHub, GitLab, Linear and more.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/rejochandran/issue-jump.git" },
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui/run.mjs",
    "test:all": "npm test && npm run test:ui && npm run check",
    "coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "preview": "node tools/preview/server.mjs",
    "icons": "sh scripts/icons.sh",
    "screenshots": "sh scripts/screenshots.sh",
    "wiki:shots": "sh scripts/wiki-shots.sh"
  }
}
